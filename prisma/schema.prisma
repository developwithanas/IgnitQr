generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String // "" for Google-only accounts (no password set)
  emailVerifiedAt DateTime?
  googleId        String?
  plan            String    @default("Starter")
  planExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Admin control
  role          String    @default("user") // "user" | "staff" | "admin"
  status        String    @default("active") // "active" | "blocked"
  blockedReason String?
  blockedUntil  DateTime? // null = blocked until manually unblocked
  tokenVersion  Int       @default(0) // bump to force logout everywhere

  // Activity
  lastLoginAt   DateTime?
  loginCount    Int       @default(0)
  lastSeenAt    DateTime?
  activeSeconds Int       @default(0)

  payments     Payment[]
  loginEvents  LoginEvent[]
  activityDays ActivityDay[]
  resetTokens  PasswordResetToken[]
  emailOtps    EmailOtp[]

  @@index([googleId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ActivityDay {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD (IST)
  seconds Int    @default(0)

  @@unique([userId, day])
  @@index([day])
}

model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  adminEmail   String
  action       String
  targetUserId String?
  targetEmail  String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  plan      String
  amount    Int // in paise
  currency  String   @default("INR")
  coupon    String?
  method    String // "razorpay" | "upi"
  status    String // "created" | "paid" | "pending_review" | "failed"
  orderId   String?  @unique
  paymentId String?  @unique
  reference String? // UPI transaction ID (UTR) for manual payments
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Business {
  id         String   @id @default(cuid())
  userId     String
  name       String
  googleLink String
  slug       String   @unique
  location   String?  @default("Main Branch")
  qrCodes    QrCode[]
}

model Feedback {
  id             String   @id @default(cuid())
  rating         Int
  content        String?
  aiContent      String?
  qrCodeId       String
  createdAt      DateTime @default(now())
  customerName   String?
  customerStatus String?  @default("Active")
  qrCode         QrCode   @relation(fields: [qrCodeId], references: [id])
}

model QrCode {
  id         String     @id @default(cuid())
  businessId String
  scans      Int        @default(0)
  feedbacks  Feedback[]
  business   Business   @relation(fields: [businessId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the token; the raw token is only in the link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailOtp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
