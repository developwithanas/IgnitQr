generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  plan          String    @default("Starter")
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  plan      String
  amount    Int // in paise
  currency  String   @default("INR")
  coupon    String?
  method    String // "razorpay" | "upi"
  status    String // "created" | "paid" | "pending_review" | "failed"
  orderId   String?  @unique
  paymentId String?  @unique
  reference String? // UPI transaction ID (UTR) for manual payments
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Business {
  id         String   @id @default(cuid())
  userId     String
  name       String
  googleLink String
  slug       String   @unique
  location   String?  @default("Main Branch")
  qrCodes    QrCode[]
}

model Feedback {
  id             String   @id @default(cuid())
  rating         Int
  content        String?
  aiContent      String?
  qrCodeId       String
  createdAt      DateTime @default(now())
  customerName   String?
  customerStatus String?  @default("Active")
  qrCode         QrCode   @relation(fields: [qrCodeId], references: [id])
}

model QrCode {
  id         String     @id @default(cuid())
  businessId String
  scans      Int        @default(0)
  feedbacks  Feedback[]
  business   Business   @relation(fields: [businessId], references: [id])
}
